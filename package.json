{
  "name": "djrt-invoice",
  "version": "1.0.0",
  "description": "DJRT Invoice and Calculation App",
  "main": "main.js",
  "author": "DJRT",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis" },
  "devDependencies": { "electron": "^35.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "com.djrt.invoice",
    "productName": "DJRT Invoice",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
